  {
   "id": "la3",
   "roughness": 0,
   "createdAt": "2026-10-12T12:00:00.000Z",
   "updatedAt": "2026-10-12T12:00:00.000Z",
   "version": 1,
   "type": "text",
   "x": 34,
   "y": 66,
   "text": "One hasher chip trace. Rows are a public schedule; everything non-local is a linear claim.",
