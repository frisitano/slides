  },
  {
   "id": "mv53uzso5ka6vl5jrt2",
   "type": "rectangle",
   "x": 96,
   "y": 658,
   "width": 490,
   "height": 96,
   "backgroundColor": "#ffffff",
   "strokeColor": "#dee2e6",
   "strokeWidth": 1,
   "roughness": 0,
   "createdAt": "2026-10-12T10:24:38.333Z",
