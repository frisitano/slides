      "type": "text",
      "x": 666,
      "y": 712,
      "strokeColor": "#1e1e1e",
      "text": "sR[j] = -(rᴹ+1) / (r w⁻¹u⁻ʲ-1)",
      "fontSize": 22,
      "fontFamily": 3,
      "createdAt": "2026-10-12T10:24:38.333Z",
      "updatedAt": "2026-10-12T10:24:38.333Z",
