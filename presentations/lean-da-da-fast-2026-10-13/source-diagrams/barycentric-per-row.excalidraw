      "type": "text",
      "x": 666,
      "y": 674,
      "strokeColor": "#1e1e1e",
      "text": "sL[j] =  (rᴹ-1) / (r u⁻ʲ-1)",
      "fontSize": 22,
      "fontFamily": 3,
