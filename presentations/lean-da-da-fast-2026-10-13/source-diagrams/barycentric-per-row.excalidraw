  {
   "id": "mv53uzsoea5mhcx6lz",
   "type": "text",
   "x": 68,
   "y": 78,
   "strokeColor": "#1e1e1e",
   "text": "Barycentric parity check per row",
   "fontSize": 32,
   "fontFamily": 2,
   "createdAt": "2026-10-12T10:24:38.332Z",
   "updatedAt": "2026-10-12T10:24:38.332Z",
   "version": 1
  },
  {
   "id": "mv53uzsobsecnku7if",
   "type": "text",
   "x": 68,
   "y": 126,
   "strokeColor": "#495057",
   "text": "One identity per row, no folding: the even and odd halves must interpolate the same polynomial.",
   "fontSize": 23,
   "fontFamily": 2,
   "createdAt": "2026-10-12T10:24:38.332Z",
   "updatedAt": "2026-10-12T10:24:38.332Z",
   "version": 1
  },
  {
   "id": "mv53uzson1r2sew2pxm",
   "type": "text",
   "x": 68,
   "y": 170,
   "strokeColor": "#1971c2",
   "text": "rootᵢ = Merkle(Cᵢ)",
   "fontSize": 26,
   "fontFamily": 3,
   "createdAt": "2026-10-12T10:24:38.332Z",
   "updatedAt": "2026-10-12T10:24:38.332Z",
