   "version": 1
  },
  {
   "id": "mv53uzsovi13qxsndz",
   "type": "text",
   "x": 124,
   "y": 692,
   "strokeColor": "#1e1e1e",
   "text": "r = H(root[0], …, root[B-1])",
   "fontSize": 23,
   "fontFamily": 3,
   "createdAt": "2026-10-12T10:24:38.333Z",
   "updatedAt": "2026-10-12T10:24:38.333Z",
   "version": 1
  },
  {
   "id": "mv53uzsow873pxnudg8",
   "type": "text",
   "x": 640,
   "y": 618,
   "strokeColor": "#6741d9",
   "text": "③ Barycentric slices",
   "fontSize": 29,
   "fontFamily": 2,
   "createdAt": "2026-10-12T10:24:38.333Z",
   "updatedAt": "2026-10-12T10:24:38.333Z",
   "version": 1
  },
  {
   "id": "mv53uzsokb6uinh1yl",
   "type": "rectangle",
   "x": 640,
   "y": 658,
   "width": 554,
   "height": 96,
   "backgroundColor": "#ffffff",
   "strokeColor": "#dee2e6",
   "strokeWidth": 1,
   "roughness": 0,
   "createdAt": "2026-10-12T10:24:38.333Z",
   "updatedAt": "2026-10-12T10:24:38.333Z",
   "version": 1
  },
  {
   "id": "mv53uzsoedjlivswl29",
   "type": "text",
   "x": 666,
   "y": 674,
   "strokeColor": "#1e1e1e",
   "text": "sL[j] =  (r^M - 1) / (r·u^-j - 1)",
   "fontSize": 23,
   "fontFamily": 3,
   "createdAt": "2026-10-12T10:24:38.333Z",
   "updatedAt": "2026-10-12T10:24:38.333Z",
   "version": 1
  },
  {
   "id": "mv53uzsoomm221oj8u",
   "type": "text",
   "x": 666,
   "y": 712,
   "strokeColor": "#1e1e1e",
   "text": "sR[j] = -(r^M + 1) / (r·w^-1·u^-j - 1)",
   "fontSize": 23,
   "fontFamily": 3,
   "createdAt": "2026-10-12T10:24:38.333Z",
   "updatedAt": "2026-10-12T10:24:38.333Z",
   "version": 1
  },
  {
   "id": "mv53uzsocd24a20z75f",
   "type": "text",
   "x": 44,
   "y": 790,
   "strokeColor": "#2b8a3e",
   "text": "④ Row identity",
   "fontSize": 29,
   "fontFamily": 2,
   "createdAt": "2026-10-12T10:24:38.333Z",
   "updatedAt": "2026-10-12T10:24:38.333Z",
   "version": 1
  },
  {
   "id": "mv53uzso7hbf89njksf",
   "type": "rectangle",
   "x": 96,
   "y": 830,
   "width": 1098,
   "height": 86,
   "backgroundColor": "#d3f9d8",
   "strokeColor": "#2b8a3e",
   "strokeWidth": 2,
   "roughness": 0,
   "createdAt": "2026-10-12T10:24:38.334Z",
   "updatedAt": "2026-10-12T10:24:38.334Z",
   "version": 1
  },
  {
   "id": "mv53uzso2k5xeooyamp",
   "type": "text",
   "x": 350,
   "y": 858,
   "strokeColor": "#1e1e1e",
   "text": "Σⱼ sL[j] · v₂ⱼ   =   Σⱼ sR[j] · v₂ⱼ₊₁",
   "fontSize": 27,
   "fontFamily": 3,
   "createdAt": "2026-10-12T10:24:38.334Z",
   "updatedAt": "2026-10-12T10:24:38.334Z",
   "version": 1
  },
  {
   "id": "mv53uzsoegbf0hrlhuq",
   "type": "text",
   "x": 96,
   "y": 938,
   "strokeColor": "#868e96",
   "text": "Checked independently for every row — paid once per committed row.",
   "fontSize": 21,
   "fontFamily": 2,
   "createdAt": "2026-10-12T10:24:38.334Z",
